<mvc:View
	controllerName="de.sycor.packtable.controller.CreateHU"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page
        xmlns="sap.m"
        id="pageId"
        floatingFooter="true"
        showHeader="false"
        busyIndicatorDelay="0"
    >
        <content>
            <VBox>
                <items>
                    <!--Packing Form - Einpacken Visible if HUModel>/Action === "E"-->
                    <f:Form
                        editable="true"
                        id="form0_pack" visible="{= ${HUModel>/Action} === 'E' ? true : false}"
                    >
                        <f:formContainers>
                            <f:FormContainer>
                                <f:title>
                                    <core:Title
                                        class="header"
                                        text="{i18n>repack.packing.title}"
                                        id="title2"
                                        level="H2"
                                    />
                                </f:title>

                                <f:formElements>
                                    <f:FormElement>
                                        <f:fields>
                                            <Input
                                                width="100%"
                                                id="idUnterHUInput"
                                                placeholder="{i18n>repack.inputs.uhu.placeholder}"
                                                value="{HUModel>/Huident}"
                                                submit="submitHU"
                                                liveChange="HUInputChange"
                                                required="true"
                                                busyIndicatorSize="Auto"
                                                busyIndicatorDelay="0"
                                            />
                                        </f:fields>
                                    </f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>

                        <f:layout>
                            <f:ResponsiveGridLayout id="layout0" />
                        </f:layout>
                    </f:Form>
                   <!--Unpacking Form - Auspacken Visible if HUModel>/Action === "A"-->
                    <f:Form
                        editable="true"
                        id="form0_unpack" visible="{= ${HUModel>/Action} === 'A' ? true : false}"
                    >
                        <f:formContainers>
                            <f:FormContainer>
                                <f:title>
                                    <core:Title
                                        class="header"
                                        text="{i18n>repack.unpacking.title}"
                                        id="title3"
                                        level="H2"
                                    />
                                </f:title>

                                <f:formElements>
                                    <f:FormElement>
                                        <f:fields>
                                            <Input
                                                width="100%"
                                                id="idHauptHUInput"
                                                placeholder="{i18n>repack.inputs.hhu.placeholder}"
                                                value="{HUModel>/Huident}"
                                                submit="submitHU"
                                                liveChange="HUInputChange"
                                                required="true"
                                                busyIndicatorSize="Auto"
                                                busyIndicatorDelay="0"
                                            />
                                        </f:fields>
                                    </f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>

                        <f:layout>
                            <f:ResponsiveGridLayout id="layout1" />
                        </f:layout>
                    </f:Form>
                </items>
            </VBox>
        </content>

        <footer>
			<OverflowToolbar
				id="toolbar"
				busyIndicatorDelay="0"
			>
				<Button
					type="Reject"
					press="back"
					text="{i18n>repack.buttons.abort}"
					id="abortButton"
					busyIndicatorDelay="0"
					width="30%"
				/>
				<ToolbarSpacer/>
				<Button
					type="Accept"
					press="submitHU"
					text="{i18n>repack.buttons.confirm}"
					id="bookButton"
					busyIndicatorDelay="0"
					width="65%"
				/>
				<content/>
			</OverflowToolbar>
        </footer>
    </Page>
</mvc:View>