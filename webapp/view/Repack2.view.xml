										</f:fields>
									</f:FormElement>
									<f:FormElement
										id = "repackFormElementchangeHU"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.repackHUFrom.pmat.title}"
									>
										<f:fields>
											<Input
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="100%"
												id="changeHU"
												value="{HUModel>/Huident}"
												required="true"
												busyIndicatorSize="Auto"
												submit="submitHU"
												liveChange="submitHU"
												busyIndicatorDelay="0"
												editable="true"
											/>
										</f:fields>
									</f:FormElement>									
									<f:FormElement
										id = "repackFormElementchangeHUPmat"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.createHU.pmat.title}"
									>
										<f:fields>
											<ComboBox
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="100%"
												id="changeHUPMat"
												required="true"
												busyIndicatorSize="Auto"
												busyIndicatorDelay="0"
												selectedKey="{HUModel>/PmatGuid}"
												editable="true"
												items="{/PackagingMaterialSet}">
												<core:Item key="{Matnr}" text="{Matnr} - ({Maktx})" />
											</ComboBox>
										</f:fields>
									</f:FormElement>
									
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>

                        <f:layout>
                            <f:ResponsiveGridLayout id="layout03" />
                        </f:layout>
                    </f:Form>										

