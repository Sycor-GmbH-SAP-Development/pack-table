                                        <f:fields>
                                            <Input
                                                xmlns:mvc="sap.ui.core.mvc"
                                                xmlns:l="sap.ui.layout"
                                                xmlns:f="sap.ui.layout.form"
                                                xmlns:core="sap.ui.core"
                                                xmlns="sap.m"
                                                width="100%"
                                                id="repackMatnr"
                                                value="{HUModel>/Matnr}"
                                                required="true"
                                                busyIndicatorSize="Auto"
                                                busyIndicatorDelay="0"
                                                editable="true"
                                            />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement
                                        xmlns:mvc="sap.ui.core.mvc"
