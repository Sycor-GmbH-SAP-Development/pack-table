                                        xmlns:core="sap.ui.core"
                                        xmlns:f="sap.ui.layout.form"
                                        label="{i18n>repack.quantity.label}"
                                        id="element5_copy5"
                                    >
                                        <f:fields>
										    <HBox >
                                            <Input
                                                xmlns:mvc="sap.ui.core.mvc"
                                                xmlns:l="sap.ui.layout"
                                                xmlns:f="sap.ui.layout.form"
                                                xmlns:core="sap.ui.core"
                                                xmlns="sap.m"
                                                width="40%"
                                                id="repackQuan"
                                                value="{path : 'HUModel>/Menge', formatter : '.normalizeFormatter'}"
                                                required="true"
                                                busyIndicatorSize="Auto"
                                                busyIndicatorDelay="0"
												type="Number"
                                                editable="true"
                                            />
