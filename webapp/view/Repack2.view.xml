<mvc:View
	controllerName="de.sycor.packtable.controller.Repack2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page
        xmlns="sap.m"
        id="pageId"
        floatingFooter="true"
        showHeader="false"
        busyIndicatorDelay="0"
    >
        <content>
            <VBox>
                <items>
				<!--Create HU Form - Einpacken Visible if HUModel>/Action === "A"-->
                    <f:Form
                        editable="true"
                        id="formCreateHU"
						visible="{= ${HUModel>/Action} === 'A' ? true : false}"
                    >
                        <f:formContainers>
                            <f:FormContainer>
                                <f:title>
                                    <core:Title
                                        class="header"
                                        text="{i18n>repack2.createHU.title}"
                                        id="title2"
                                        level="H2"
                                    />
                                </f:title>

                                <f:formElements>
									<f:FormElement
										id = "repackFormElementCreateHULoc"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.createHU.sloc.title}"
									>
										<f:fields>
											<Input
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="100%"
												id="createHULoc"
												value="{HUModel>/Lgpla}"
												required="true"
												busyIndicatorSize="Auto"
												busyIndicatorDelay="0"
												editable="false"
											/>
										</f:fields>
									</f:FormElement>
									<f:FormElement
										id = "repackFormElementCreateHUPmat"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.createHU.pmat.title}"
									>
										<f:fields>
											<ComboBox
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="100%"
												id="createHUPMat"
												required="true"
												busyIndicatorSize="Auto"
												busyIndicatorDelay="0"
												editable="true"
												items="{/PackagingMaterialSet}">
												<core:Item key="{Matnr}" text="{Matnr} - ({Maktx})" />
											</ComboBox>
										</f:fields>
									</f:FormElement>
									<f:FormElement
										id = "repackFormElementCreateHUQuan"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.createHU.Quan.title}"
									>
										<f:fields>
											<Input
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="20%"
												id="createHUQuan"
												value="{HUModel>/Anzahl}"
												required="true"
												type="Number"
												busyIndicatorSize="Auto"
												busyIndicatorDelay="0"
												editable="true"
											/>
										</f:fields>
									</f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>

                        <f:layout>
                            <f:ResponsiveGridLayout id="layout0" />
                        </f:layout>
                    </f:Form>

				<!--Repack Form - Einpacken Visible if HUModel>/Action === "B"-->
                    <f:Form
                        editable="true"
                        id="formrepackHU"
						visible="{= ${HUModel>/Action} === 'B' ? true : false}"
                    >
