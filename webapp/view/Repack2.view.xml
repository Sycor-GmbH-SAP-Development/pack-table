        <footer>
			<OverflowToolbar
				id="toolbar"
				busyIndicatorDelay="0"
			>
				<Button
					type="Reject"
					press="back"
					text="{i18n>repack2.buttons.abort}"
					id="abortButton"
					busyIndicatorDelay="0"
					width="30%"
				/>
				<ToolbarSpacer/>
				<Button
					type="Accept"
					press="submit"
					text="{i18n>repack2.buttons.confirm}"
