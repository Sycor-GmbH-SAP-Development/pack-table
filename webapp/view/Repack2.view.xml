										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.createHU.sloc.title}"
									>
										<f:fields>
											<Input
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="100%"
												id="repackHULoc"
												value="{HUModel>/Lgpla}"
												required="true"
												busyIndicatorSize="Auto"
												busyIndicatorDelay="0"
												editable="false"
											/>
										</f:fields>
									</f:FormElement>
									<f:FormElement
										id = "repackFormElementRepackHUFrom"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
										xmlns:core="sap.ui.core"
										xmlns:f="sap.ui.layout.form"
										label="{i18n>repack2.inputs.repackHUFrom.pmat.title}"
									>
										<f:fields>
											<Input
												xmlns:mvc="sap.ui.core.mvc"
												xmlns:l="sap.ui.layout"
												xmlns:f="sap.ui.layout.form"
												xmlns:core="sap.ui.core"
												xmlns="sap.m"
												width="100%"
												id="repackHUFrom"
												value="{HUModel>/Huident}"
												required="true"
												busyIndicatorSize="Auto"
												submit="submitHU"
												liveChange="submitHU"
												busyIndicatorDelay="0"
												editable="true"
											/>
										</f:fields>
									</f:FormElement>
									<f:FormElement
										id = "repackFormElementRepackHUTo"
										xmlns:mvc="sap.ui.core.mvc"
										xmlns="sap.m"
										xmlns:l="sap.ui.layout"
