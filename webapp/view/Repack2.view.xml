                                                xmlns:mvc="sap.ui.core.mvc"
                                                xmlns:l="sap.ui.layout"
                                                xmlns:f="sap.ui.layout.form"
                                                xmlns:core="sap.ui.core"
                                                xmlns="sap.m"
                                                width="100%"
                                                id="repackQuanUnit"
                                                text="{HUModel>/Meins}"
                                                busyIndicatorSize="Auto"
                                                busyIndicatorDelay="0"
                                            />
											</HBox>
                                        </f:fields>
                                    </f:FormElement>									
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>

                        <f:layout>
